# Payload core
PAYLOAD_SECRET=replace-with-32-random-bytes
PAYLOAD_PUBLIC_SERVER_URL=https://admin.aaavatar.nl

# Postgres — Supabase project. The schema=payload qualifier keeps Payload's
# tables out of public.* so your existing app schema is untouched.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=payload

# Resend — newsletter sending. Domain "aaavatar.nl" must be verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=news@aaavatar.nl
RESEND_FROM_NAME=Aaavatar

# Supabase — used to fetch newsletter recipient lists (audience filtering).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage — S3-compatible endpoint for the announcement-media bucket.
# Find values under Project Settings → Storage → S3 connection.
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=announcement-media
