# Payload core
PAYLOAD_SECRET=replace-with-32-random-bytes
PAYLOAD_PUBLIC_SERVER_URL=https://admin.aaavatar.nl

# Admin MFA gate (audit HIGH #11). The middleware redirects every browser
# request to /admin to /mfa unless the holder presents a valid TOTP code.
# Generate both values once with `node scripts/setup-mfa.mjs` and set them
# in Vercel for Production + Preview.
#   ADMIN_TOTP_SECRET         — base32 secret shared with your authenticator
#   ADMIN_MFA_SIGNING_SECRET  — HMAC key for the mfa-session cookie
ADMIN_TOTP_SECRET=
ADMIN_MFA_SIGNING_SECRET=

# Postgres — Supabase project. Use the scoped `payload_app` role created
# by backend/sql/008_payload_scoped_role.sql; this role owns the `payload`
# schema and cannot read `public.*` or `auth.*`, so admin compromise no
# longer equals full-DB compromise (audit CRITICAL #1).
#
# Use the direct (port 5432) connection — pgbouncer transaction-mode
# breaks Payload migrations (prepared statements, LISTEN/NOTIFY).
PAYLOAD_DATABASE_URL=postgresql://payload_app:<password>@db.<ref>.supabase.co:5432/postgres?schema=payload

# Legacy fallback. Still honoured by payload.config.ts if PAYLOAD_DATABASE_URL
# is unset, but should be removed from production once the scoped role is
# live in Vercel.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=payload

# Resend — newsletter sending. Domain "aaavatar.nl" must be verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=news@aaavatar.nl
RESEND_FROM_NAME=Aaavatar

# Upstash Redis — admin rate-limiters (audit MEDIUM #22). Same Upstash
# project the backend uses; the limiter keys are prefixed so they don't
# collide. If unset, rate limiters disable themselves (fail-open) and the
# admin still functions — at the cost of unmetered /api/* traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Newsletter unsubscribe — shared HMAC secret with the avatars-api
# backend so the admin can sign per-recipient unsubscribe tokens and the
# backend can verify them on click. Generate with
# `openssl rand -base64 48` and set the EXACT SAME value here and on the
# backend Vercel project. Audit HIGH #15.
UNSUBSCRIBE_SIGNING_SECRET=
# Optional override for non-prod testing. Defaults to https://api.aaavatar.nl.
# UNSUBSCRIBE_BASE_URL=https://api-preview.aaavatar.nl

# Newsletter cohort resolution now reads `public.newsletter_cohorts` via
# the scoped `payload_app` role (audit HIGH #12 — completes CRITICAL #1).
# The admin no longer needs SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY.
# Apply backend/sql/010_newsletter_cohorts_view.sql once, then remove
# these from Vercel `avatar-admin` so the next deploy can't accidentally
# read them.

# Supabase Storage — S3-compatible endpoint for the announcement-media bucket.
# Find values under Project Settings → Storage → S3 connection.
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=announcement-media
