# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# JWKS URL is derived from SUPABASE_URL; the secret below is used for HS256
# tokens when verifying JWTs issued by the project. Copy it from Supabase
# dashboard → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_ID_STARTER=price_...
PRICE_ID_PLUS=price_...
PRICE_ID_STUDIO=price_...
# Single-tier offering driven by the v1 client. €4,99 / 200 credits / month.
PRICE_ID_PRO=price_...
# One-time top-up pack: 200 credits, same EUR price as the monthly. Bought
# via /v1/checkout/topup; never expires; stacks with the monthly grant.
PRICE_ID_TOPUP_200=price_...

# --- Replicate ---
REPLICATE_API_TOKEN=r8_...

# --- App ---
# Used in Stripe Checkout return URLs. Matches the CFBundleURLTypes entry in
# the macOS app's Info.plist.
APP_URL_SCHEME=aaavatar
# Public marketing site (for legal / pricing pages linked from Checkout).
PUBLIC_SITE_URL=https://aaavatar.nl

# --- Payload CMS (admin.aaavatar.nl) ---
# Source of truth for in-app announcements + newsletter unsubscribe state.
PAYLOAD_API_URL=https://admin.aaavatar.nl/api
PAYLOAD_API_KEY=

# --- Newsletter unsubscribe (audit HIGH #15) ---
# Shared HMAC secret with the admin (avatar-admin Vercel project). Must
# be IDENTICAL on both projects so tokens admin signs in the email link
# verify in the backend on click. Generate with `openssl rand -base64 48`.
UNSUBSCRIBE_SIGNING_SECRET=

# --- Dev ---
# Comma-separated lowercase e-mails that bypass billing: /v1/account reports
# tier=pro with unlimited credits, /v1/cutout skips the credit check and
# doesn't debit. Use sparingly — these accounts get free Replicate calls.
# Empty string = no bypass.
DEV_UNLIMITED_EMAILS=
